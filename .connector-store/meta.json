    "rank": 15,
    "type": "Inbound",
    "category": "Developer Tools",
    "documentationUrl": "https://github.com/wso2-extensions/mi-inbound-streaming#readme",
    "description": "Streams large CSV, JSON, JSONL and text files from local, FTP/FTPS, SFTP or SMB2 locations into a sequence record by record or chunk by chunk, with checkpoint-based resume, parallel mediation, per-record error handling and completion callbacks.",
    "status": "Active",
    "labels": [
        "integration",
        "file",
        "streaming",
        "inbound-endpoint"
    ],
    "releases": [
