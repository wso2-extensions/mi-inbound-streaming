                            "type": "checkbox",
                            "required": false,
                            "defaultValue": "True",
                            "description": ""
                        },
                        {
                            "name": "transport.vfs.Streaming",
                            "type": "checkbox",
                            "required": false,
                            "defaultValue": "False",
                            "description": ""
                        },
                        {
                            "name": "transport.vfs.StreamingMode",
                            "type": "combo",
                            "required": false,
                            "defaultValue": "ENTIRE_FILE",
                            "description": "How the file is streamed: ENTIRE_FILE (whole file as one message), CHUNK (a batch of records per message), or RECORD (one record per message)."
                        },
                        {
                            "name": "transport.vfs.StreamingInputFormat",
                            "type": "combo",
                            "required": false,
                            "defaultValue": "text",
                            "description": "Format of the file being streamed. Determines which parser is used and which format-specific options apply."
                        },
                        {
                            "name": "transport.vfs.StreamingJsonPath",
                            "type": "string",
                            "required": false,
                            "defaultValue": "$[*]",
                            "description": "Selector marking which JSON nodes become records, e.g. $[*] or $.store.books[*]. Supports object navigation with a single wildcard; recursive descent, filters and array indexes are not supported."
                        },
                        {
                            "name": "transport.vfs.StreamingBufferSize",
                            "type": "string",
                            "required": false,
                            "defaultValue": "8192",
                            "description": "Read buffer size in bytes used by the streaming reader."
                        },
                        {
                            "name": "transport.vfs.StreamingCharset",
                            "type": "string",
                            "required": false,
                            "defaultValue": "UTF-8",
                            "description": "Charset used to decode the streamed file, e.g. UTF-8, UTF-16, ISO-8859-1. Independent of the input format."
                        },
                        {
                            "name": "transport.vfs.StreamingChunkSize",
                            "type": "string",
                            "required": false,
                            "defaultValue": "1",
                            "description": "Number of records grouped into each chunk message."
                        },
                        {
                            "name": "transport.vfs.StreamingParallelism",
                            "type": "string",
                            "required": false,
                            "defaultValue": "1",
                            "description": "How many records (RECORD mode) or chunks (CHUNK mode) of a file are mediated concurrently. 1 mediates one at a time. Higher values help when the sequence waits on a backend; the reply file, error files and checkpoint stay in file order. The sequence must complete within the injection (use blocking calls), and up to 2x this many units may be re-mediated after a crash."
                        },
                        {
                            "name": "transport.vfs.StreamingOutputProperty",
                            "type": "string",
                            "required": false,
                            "defaultValue": "",
                            "description": "When set, parsed fields are placed in a message property with this name (as a JSON string) and the message body is left empty. When left blank, the raw record/chunk content is set as the message body."
                        },
                        {
                            "name": "transport.vfs.StreamingCsvHasHeader",
                            "type": "checkbox",
                            "required": false,
                            "defaultValue": "True",
                            "description": "Whether the first row of the CSV is a header row."
                        },
                        {
                            "name": "transport.vfs.StreamingCsvDataTypes",
                            "type": "keyValueTable",
                            "required": false,
                            "defaultValue": "",
                            "description": "JSON type for selected CSV columns. Without this every cell is a string. Identify a column by header name (Is Column Name = Yes) or by 1-based position (Is Column Name = No). Applies only when Streaming Output Property is set; untyped columns and values that do not parse stay strings."
                        },
                        {
                            "name": "transport.vfs.StreamingCsvDelimiter",
                            "type": "string",
                            "required": false,
                            "defaultValue": ",",
                            "description": "Single character used to separate CSV fields."
                        },
                        {
                            "name": "transport.vfs.StreamingCsvQuote",
                            "type": "string",
                            "required": false,
                            "defaultValue": "\"",
                            "description": "Single character used to quote CSV fields that contain the delimiter or line breaks."
                        },
                        {
                            "name": "transport.vfs.StreamingAddHeadersToEachResult",
                            "type": "checkbox",
                            "required": false,
                            "defaultValue": "False",
                            "description": "In RECORD mode with raw body output, prepend the header row to each record's content."
                        },
                        {
                            "name": "transport.vfs.StreamingParseErrorAction",
                            "type": "combo",
                            "required": false,
                            "defaultValue": "MOVE",
                            "description": "What to do with a record that fails to parse (JSONL only): MOVE appends it to the parse-error folder; DROP discards it. Either way processing continues with the next record."
                        },
                        {
                            "name": "transport.vfs.StreamingParseErrorFolder",
                            "type": "string",
                            "required": false,
                            "defaultValue": "",
                            "description": "VFS URI of the folder where parse-error records are moved (one sidecar per source file, named <name>.parse.fail.<ext>). When empty, falls back to the fault folder (Move After Failure); if that is also empty, parse errors are logged only."
                        },
                        {
                            "name": "transport.vfs.StreamingMediationErrorAction",
                            "type": "combo",
                            "required": false,
                            "defaultValue": "MOVE",
                            "description": "What to do with a record/chunk whose mediation (injection to the sequence) fails: MOVE appends it to the mediation-error folder; DROP discards it. Either way processing continues."
                        },
                        {
                            "name": "transport.vfs.StreamingMediationErrorFolder",
                            "type": "string",
                            "required": false,
                            "defaultValue": "",
                            "description": "VFS URI of the folder where mediation-error records are moved (one sidecar per source file, named <name>.mediation.fail.<ext>). When empty, falls back to the parse-error folder, then the fault folder; if all are empty, mediation errors are logged only."
                        },
                        {
                            "name": "transport.vfs.StreamingCheckpointEnabled",
                            "type": "checkbox",
                            "required": false,
                            "defaultValue": "True",
                            "description": "Write a resume point to the MI registry so a restart continues mid-file instead of reprocessing from the beginning. Requires a shared registry in a cluster."
                        },
                        {
                            "name": "transport.vfs.StreamingCheckpointInterval",
                            "type": "string",
                            "required": false,
                            "defaultValue": "1000",
                            "description": "Flush the checkpoint every this many confirmed units - records in RECORD mode, chunks in CHUNK mode. Lower means less re-work after a restart but more registry writes."
                        },
                        {
                            "name": "transport.vfs.StreamingReadRetries",
                            "type": "string",
                            "required": false,
                            "defaultValue": "3",
                            "description": "Consecutive read failures without progress tolerated when the connection drops mid-file (SFTP 'Pipe closed', connection reset). Each time the file is opened again and the read resumes at the byte where it stopped; no record is repeated or lost. 0 turns this off: the first failure fails the file."
                        },
                        {
                            "name": "transport.vfs.StreamingReadRetryDelay",
                            "type": "string",
                            "required": false,
                            "defaultValue": "5000",
                            "description": "Pause before a read retry in milliseconds, multiplied by the failure count (5000 waits 5 s, then 10 s, then 15 s)."
                        },
                        {
                            "name": "transport.vfs.StreamingFileCompleteSequence",
                            "type": "keyOrExpression",
                            "required": false,
                            "defaultValue": "",
                            "description": "Sequence invoked once after a file has been streamed to completion, with the file totals. Leave blank for no callback."
                        },
                        {
                            "name": "transport.vfs.StreamingFileFailureSequence",
                            "type": "keyOrExpression",
                            "required": false,
                            "defaultValue": "",
                            "description": "Sequence invoked once after a file is treated as a whole-file failure, with the file totals. Leave blank for no callback."
                        },
